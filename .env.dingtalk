# 钉钉应用配置
# 钉钉开放平台申请应用后获得这些配置信息
VITE_DINGTALK_APP_KEY=your_app_key_here
VITE_DINGTALK_APP_SECRET=your_app_secret_here
VITE_DINGTALK_AGENT_ID=your_agent_id_here

# Netlify部署环境配置
VITE_APP_ENV=dingtalk
VITE_APP_TITLE=固定资产管理系统

# API配置（使用钉钉云函数或外部API）
VITE_API_BASE_URL=https://your-api-domain.com/api
# 或者使用本地Mock（开发环境）
VITE_USE_MOCK=true

# 钉钉企业内部应用配置
VITE_DINGTALK_CORP_ID=your_corp_id_here
